  "ruleset_toml": "[timing]\ntick_rate            = 60      # ticks per second\nround_ticks          = 260    # 90 seconds\nintermission_ticks   = 480     # 8 seconds\nopening_freeze_ticks = 90      # inputs discarded during this\nrounds_to_win        = 1       # best of 3\nmax_rounds           = 5\n\n[arena]\narena_width          = 2400    # units\nceiling              = 900\nfighter_height       = 1000\nfighter_width        = 72\nstart_separation     = 600\n\n[meters]\nvitality             = 1000\nsurge_max            = 300\nguard_max            = 100\n\n[agent]\nobservation_delay    = 4       # ticks the agent's view lags reality\nreflex_interval      = 5       # agents are polled every N ticks\n\n[movement]\ngravity              = 3200    # units per second squared\nwalk_speed           = 340     # units per second\ndash_speed           = 900\ndash_ticks           = 14\njump_velocity        = 1500\n\n[sudden_death]\nticks                = 1800\nvitality              = 250\n\n[passivity]\nwarning_ticks        = 300\npenalty_fraction_pct = 10      # percent of current vitality subtracted on 2nd warning\n\n[guard_crush]\ncrush_ticks          = 40\nrefill_to            = 50\n\n[throw]\ntech_window_ticks    = 7\n\n[moves.light]\nstartup = 4\nactive = 2\nrecovery = 7\ndamage = 30\nblock_damage = 6\nhitstun = 12\nblockstun = 8\nguard_damage = 6\nhitstop = 4\n\n[moves.medium]\nstartup = 7\nactive = 3\nrecovery = 14\ndamage = 60\nblock_damage = 12\nhitstun = 18\nblockstun = 12\nguard_damage = 12\nhitstop = 6\n\n[moves.heavy]\nstartup = 12\nactive = 4\nrecovery = 22\ndamage = 100\nblock_damage = 20\nhitstun = 26\nblockstun = 16\nguard_damage = 22\nhitstop = 10\n\n[moves.throw]\nstartup = 5\nactive = 2\nrecovery = 20\ndamage = 120\nhitstop = 8\n\n[combo]\nscaling_pct = [100, 90, 80, 70, 60, 50]\nfloor_pct = 20\nhard_knockdown_hit = 15\n\n[hitboxes]\n# Rectangles are [x_offset, y_offset, width, height] relative to fighter origin (feet, facing-forward-positive x).\n# Standing normals\nlight_hitbox    = [40, 550, 90, 120]\nmedium_hitbox   = [40, 500, 110, 160]\nheavy_hitbox    = [40, 450, 130, 220]\nthrow_hitbox    = [30, 400, 80, 300]\n# Crouching normals (lower)\nlight_hitbox_crouch  = [40, 250, 90, 120]\nmedium_hitbox_crouch = [40, 220, 110, 140]\n# Hurtboxes (six regions), standing\nhurt_head      = [-30, 850, 60, 150]\nhurt_torso     = [-40, 500, 80, 350]\nhurt_arm_left  = [-70, 500, 30, 300]\nhurt_arm_right = [40, 500, 30, 300]\nhurt_leg_left  = [-40, 0, 35, 500]\nhurt_leg_right = [5, 0, 35, 500]\n# Hurtboxes, crouching (compressed vertically)\nhurt_head_crouch      = [-30, 500, 60, 130]\nhurt_torso_crouch     = [-40, 250, 80, 260]\nhurt_arm_left_crouch  = [-70, 250, 30, 220]\nhurt_arm_right_crouch = [40, 250, 30, 220]\nhurt_leg_left_crouch  = [-40, 0, 35, 260]\nhurt_leg_right_crouch = [5, 0, 35, 260]\n",
